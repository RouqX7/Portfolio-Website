rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /portfolio/{allPaths=**} {
      allow read: if true;  // Anyone can read portfolio images and videos
      allow write: if request.auth != null;  // Only authenticated users can upload
    }
    match /cvs/{allPaths=**} {
      allow read: if true;  // Anyone can read CVs
      allow write: if request.auth != null;  // Only authenticated users can upload
    }
  }
}

